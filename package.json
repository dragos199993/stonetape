{
  "name": "stonetape",
  "version": "0.1.0-alpha.4",
  "description": "Turn real agent runs into fast, hermetic regression tests. Record real LLM API interactions once, replay them deterministically in CI — zero tokens, zero flakiness.",
  "keywords": [
    "llm",
    "testing",
    "record",
    "replay",
    "vcr",
    "cassette",
    "deterministic",
    "ci",
    "openai",
    "anthropic",
    "vercel-ai-sdk",
    "vitest",
    "mock",
    "fixtures",
    "regression"
  ],
  "homepage": "https://stonetape.dev",
  "bugs": "https://github.com/dragos199993/stonetape/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragos199993/stonetape.git"
  },
  "license": "MIT",
  "author": "Dragos Nedelcu",
  "type": "module",
  "bin": {
    "stonetape": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/runner/vitest.d.ts",
      "default": "./dist/runner/vitest.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "tsup && node examples/demo.mjs",
    "record:agent": "STONETAPE_MODE=record vitest run tests/openai-agent.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "openai": "^7.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
